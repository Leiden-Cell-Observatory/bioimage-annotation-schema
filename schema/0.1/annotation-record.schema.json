  "$id": "https://w3id.org/bioimage-annotation-schema",
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "excluded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "mask_file"
          ]
        },
        "properties": {
          "mask_file": {}
        }
      }
    },
    {
      "if": {
        "properties": {
          "patch_x": {}
        },
        "required": [
          "patch_x"
        ]
      },
      "then": {
        "properties": {
          "patch_height": {},
          "patch_width": {},
          "patch_y": {}
        },
        "required": [
          "patch_y",
          "patch_width",
          "patch_height"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "z_start": {}
        },
        "required": [
          "z_start"
        ]
      },
      "then": {
        "properties": {
          "z_end": {}
        },
        "required": [
          "z_end"
        ]
      }
    }
  ],
  "description": "One annotation of a set: the image region it covers, its split, its state and its files. Flat, so a table of records is a CSV file with one column per field (well_metadata and external_ids as JSON text).",
  "metamodel_version": "1.12.0",
  "properties": {
    "annotation_id": {
      "description": "Identifier of the annotation, unique within the set. Files are named after it.",
      "type": "string"
    },
    "annotation_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnnotationType"
        },
        {
          "type": "null"
        }
      ]
    },
    "channel": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "created_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "external_ids": {
      "description": "Identifiers of copies in other systems as a JSON object, e.g. {\"omero_roi\":\"123\",\"omero_label_image\":\"456\"}.",
      "type": [
        "string",
        "null"
      ]
    },
    "field": {
      "description": "Field (well sample) within the well.",
      "type": [
        "string",
        "null"
      ]
    },
    "image_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "image_uri": {
      "description": "The source image - omero:image:<id>, an http(s) URL of an OME-Zarr image, or another resolvable URI.",
      "type": "string"
    },
    "input_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "input_file": {
      "description": "Path of the annotated image region, relative to the set's folder.",
      "type": [
        "string",
        "null"
      ]
    },
    "input_iscc": {
      "pattern": "^ISCC:[A-Z2-7]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "level": {
      "description": "Multiscale level the coordinates refer to (0 = full resolution).",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "mask_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "mask_file": {
      "description": "Path of the mask, relative to the set's folder.",
      "type": [
        "string",
        "null"
      ]
    },
    "mask_iscc": {
      "pattern": "^ISCC:[A-Z2-7]+$",
      "type": [
        "string",
        "null"
      ]
    },
    "patch_height": {
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "patch_width": {
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "patch_x": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "patch_y": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "session": {
      "description": "id of the session (in the set) that last saved this annotation.",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "split": {
      "$ref": "#/$defs/SplitName"
    },
    "status": {
      "$ref": "#/$defs/RecordStatus"
    },
    "timepoint": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "updated_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "well": {
      "description": "Plate well, e.g. B2.",
      "type": [
        "string",
        "null"
      ]
    },
    "well_metadata": {
      "description": "Key-value metadata of the well as a JSON object, e.g. {\"cell_line\":\"U2OS\"}.",
      "type": [
        "string",
        "null"
      ]
    },
    "z_end": {
      "description": "Last z-slice of a volumetric annotation (inclusive).",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "z_slice": {
      "description": "Z-slice of a 2D annotation.",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "z_start": {
      "description": "First z-slice of a volumetric annotation.",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "annotation_id",
    "image_uri",
    "split",
    "status"
  ],
  "title": "bioimage_annotation_schema",
  "type": "object",
  "version": "0.1.0"
}

